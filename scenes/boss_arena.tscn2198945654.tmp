[sub_resource type="GDScript" id="GDScript_t71na"]
script/source = "extends CanvasLayer

@onready var score_label: Label = $ScoreLabel
@onready var multiplier_label: Label = $MultiplierLabel
@onready var combo_bar = $ComboBar

@export var pulse_speed := 4.0      # How fast the bar breathes (higher = faster)
@export var scale_intensity := 0.03  # How much it expands (0.03 = 3% size change)
@export var glow_intensity := 0.15   # How much the brightness fluctuates
var base_scale := Vector2.ONE

func _ready() -> void:
	# 1. Store the starting design scale
	base_scale = scale
	
	# 2. CRUCIAL: Set the pivot offset to the exact center of the bar
	# This ensures it breathes outward evenly from the middle, not from the top-left!
	await get_tree().process_frame
	$ComboBar.pivot_offset = $ComboBar.size / 2.0
	
	if has_node(\"/root/ScoreManager\"):
		var sm := get_node(\"/root/ScoreManager\")
		sm.score_changed.connect(_on_score_changed)
		_on_score_changed(sm.score)

	if has_node(\"/root/ComboManager\"):
		var combo := get_node(\"/root/ComboManager\")
		combo.multiplier_changed.connect(_on_multiplier_changed)
		combo.combo_kill.connect(_on_combo_kill)
		combo.combo_broken.connect(_on_combo_broken)
		combo.combo_started.connect(_on_combo_started)
		_on_multiplier_changed(combo.multiplier)

	combo_bar.visible = false
	multiplier_label.visible = false

func _on_score_changed(new_score: int) -> void:
	score_label.text = \"Score: %d\" % new_score

func _on_multiplier_changed(new_multiplier: int) -> void:
	multiplier_label.text = \"x%d\" % new_multiplier

func _on_combo_started() -> void:
	combo_bar.visible = true
	multiplier_label.visible = true

func _on_combo_kill(_multiplier: int, time_remaining: float, time_max: float) -> void:
	combo_bar.visible = true
	combo_bar.max_value = time_max
	combo_bar.value = time_remaining

func _on_combo_broken(_final_multiplier: int, _final_streak: int) -> void:
	combo_bar.visible = false

func _process(_delta: float) -> void:
	# Keep the bar draining smoothly between kill events rather than only
	# snapping to a new value each time combo_kill fires.
	if has_node(\"/root/ComboManager\"):
		var combo := get_node(\"/root/ComboManager\")
		if combo.combo_active:
			combo_bar.value = combo.time_remaining
			
	pulsing_bar()

func pulsing_bar():
	if $ComboBar.visible:
		# Create a continuous looping wave between -1.0 and 1.0 using engine TIME
		var wave = sin(Time.get_ticks_msec() * 0.001 * pulse_speed)
		
		# Calculate the current fill percentage (0.0 to 1.0)
		var fill_ratio = $ComboBar.value / $ComboBar.max_value
		
		# If the bar drops below 25%, double the speed and intensity!
		if fill_ratio < 0.5:
			pulse_speed = 12.0       # Rapid hyper-pulse
			scale_intensity = 0.06   # Exaggerated shake size
			
			# Optional: Shift the bar color toward bright warning red
			#$ComboBar.modulate = Color(\"#ff3333\") 
		else:
			# Reset back to calm defaults when full
			pulse_speed = 4.0
			scale_intensity = 0.03
			# Keep your original powerup theme colors here (e.g., Cyan or Pink)
		
		# 3. BREATHING SCALE ANIMATION
		# Scale expands when wave is positive, shrinks when negative
		$ComboBar.scale = base_scale + Vector2.ONE * (wave * scale_intensity)
		
		# 4. GLOWING BRIGHTNESS ANIMATION
		# We use RAW/HDR color values to drive a neon brightness fluctuation
		# (Works beautifully if you have WorldEnvironment Glow enabled!)
		var energy_multiplier = 1.0 + (wave * glow_intensity)
		
		# Gently brighten/dim the self_modulate layer
		$ComboBar.self_modulate.v = energy_multiplier 
	else:
		# Reset back to perfect defaults if the bar disappears
		$ComboBar.scale = base_scale
		$ComboBar.self_modulate.v = 1.0
"

